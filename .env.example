# 2711 Editor — environment template
# Copy to backend/.env and fill in secrets

# === Required ===
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=your-secret-key-here
AI_MODEL=deepseek-chat

# === Optional: scene image generation ===
# IMAGE_API_BASE=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=dall-e-3

# === Narrative pipeline tuning (defaults tuned for ~5 min @ 20k chars) ===
# FAST_OUTLINE=1
# FAST_SCENES=1
# BIBLE_FAST_MODEL=1
# SCENE_BATCH_SIZE=8
# LLM_BATCH_CONCURRENCY=4
# OUTLINE_ATTEMPTS=1
# OUTLINE_MAX_ATTEMPTS=1
# OUTLINE_TIMEOUT_FAIL_FAST=1
# NARRATIVE_FAST_PATH_CHARS=8000
# SKIP_OUTLINE_BELOW_CHARS=8000
# OUTLINE_SKIP_MAX_CHARS=20000
# OUTLINE_SKIP_MIN_BEATS=6
# NARRATIVE_SPEED_MODE=fast

# 文件上传与正文提取（可选，0 = 不限制，为默认值）
# MAX_UPLOAD_MB=0
# MAX_EXTRACT_CHARS=0
# MAX_CREATE_CHARS=0
# LLM_INPUT_CHARS=0
# LLM_MODEL_SAFE_CHARS=0
# MAX_PDF_PAGES=0
# PDF_PAGE_HARD_CAP=0
