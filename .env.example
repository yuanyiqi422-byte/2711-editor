# 2711 Editor — environment template
# Copy to backend/.env and fill in secrets

# === Required ===
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=your-secret-key-here
AI_MODEL=deepseek-chat

# === Optional: scene image generation ===
# IMAGE_API_BASE=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=dall-e-3

# === Upload & PDF limits ===
# MAX_UPLOAD_MB=50
# MAX_EXTRACT_CHARS=10000000
# MAX_CREATE_CHARS=10000000
# LLM_INPUT_CHARS=0
# LLM_MODEL_SAFE_CHARS=120000
# MAX_PDF_PAGES=0
# PDF_PAGE_HARD_CAP=2000

# === Dev / Docker ===
# HOST=127.0.0.1
# PORT=8010
