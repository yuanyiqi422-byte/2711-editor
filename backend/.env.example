# 复制为 .env 并填入密钥
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=your-secret-key-here
AI_MODEL=deepseek-chat

# 可选：按节点 image_prompt 实时生图（OpenAI 兼容 /images/generations）
# 未配置时使用 frontend 内置场景图库，不影响游玩
# IMAGE_API_BASE=https://api.openai.com/v1
# IMAGE_API_KEY=
#   留空则回退 AI_API_KEY（DeepSeek 等纯文本 API 不支持生图，需单独配置）
# IMAGE_MODEL=dall-e-3

# 文件上传与 PDF 提取（可选，修改后需重启服务）
# MAX_UPLOAD_MB=50
# MAX_EXTRACT_CHARS=10000000
# MAX_CREATE_CHARS=10000000
# LLM_INPUT_CHARS=0
#   0 = 上传不截字；「开始转化」时超过 LLM_MODEL_SAFE_CHARS 则智能采样
#   例如 120000 = 显式指定生成时采样字数，文本框仍显示全文
# LLM_MODEL_SAFE_CHARS=120000
# MAX_PDF_PAGES=0
#   0 = 处理全部 PDF 页（硬上限见 PDF_PAGE_HARD_CAP）
# PDF_PAGE_HARD_CAP=2000
