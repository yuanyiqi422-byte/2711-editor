# 复制为 .env 并填入密钥
# 主接口（优先）；AI_BASE_URL 为 AI_API_BASE 的别名
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=your-secret-key-here
AI_MODEL=deepseek-chat

# 备用接口：主接口 401/402/429/余额不足时自动切换一次（留空则不回退）
# AI_API_BASE_FALLBACK=https://api.deepseek.com
# AI_API_KEY_FALLBACK=your-fallback-key-here
# AI_MODEL_FALLBACK=deepseek-chat

# 主接口用尽后自动写入 AI_PRIMARY_DISABLED=1 并创建 .api-primary-disabled（勿提交）
# 重新启用：删除 backend/.api-primary-disabled，并将 AI_PRIMARY_DISABLED=0 或删除该行后重启
# AI_PRIMARY_DISABLED=0

# 推荐 AI_MODEL=deepseek-chat（结构化 JSON 最稳）。推理模型（deepseek-v4-flash 等）易截断 JSON；
# 代码会自动：非流式、读取 reasoning、局部 JSON 修复、拆分批次、回退 chat 模型。
# 若坚持用 v4，建议同时设置 AI_MODEL_FAST=deepseek-chat（圣经/大纲/场景批自动走 chat）。
# 强制关闭 LLM 流式（默认 1=开启；推理模型会自动禁用流式）：
# LLM_STREAM=0

# --- 创建流速度 / 质量（改后 uvicorn --reload-include .env 通常自动生效）---
# 完整说明见仓库根目录 AGENTS.md「创建流 · 速度 vs 质量」
# 省钱默认：跳过 LLM 大纲 + 更大场景批 + 少重试；质量下限见 prompts.py / graph_validate.py

# 可选：轻量步骤用更快模型（大纲、主角识别、圣经分析），留空则与 AI_MODEL 相同
# AI_MODEL_FAST=deepseek-chat

# LLM 请求超时（秒）：通用默认 / 大纲规划 / 场景对白
# LLM_TIMEOUT_SEC=300
# OUTLINE_LLM_TIMEOUT_SEC=180
# OUTLINE_ATTEMPTS=1
# OUTLINE_MAX_ATTEMPTS=1  # legacy alias for OUTLINE_ATTEMPTS
# OUTLINE_TIMEOUT_FAIL_FAST=1
# SCENE_LLM_TIMEOUT_SEC=420

# JSON 步骤重试次数（圣经 / 场景批，默认 2；大纲固定 1 次）
# LLM_JSON_MAX_ATTEMPTS=2

# 故事圣经 max_tokens（推理模型默认 8192）
# BIBLE_MAX_TOKENS=8192

# 大纲 / 场景批量 max_tokens（代码默认 5120 / 6144）
# OUTLINE_MAX_TOKENS=5120
# SCENE_BATCH_MAX_TOKENS=6144

# 场景对白批量：每批节点数（1-10，默认 8）、批间延迟秒（默认 0）
# SCENE_BATCH_SIZE=8
# SCENE_BATCH_DELAY_SEC=0
# 单批失败后的回退批大小（2-8，默认 4）
# FALLBACK_BATCH_SIZE=4

# 同层分支并行生成路数（1-6，默认 5）；线性主链按批顺序
# LLM_BATCH_CONCURRENCY=5

# 大纲 / 场景批量 / 圣经分析是否用快速模型（默认 1，需配置 AI_MODEL_FAST）
# FAST_OUTLINE=1
# FAST_SCENES=1
# BIBLE_FAST_MODEL=1

# 跳过 LLM 大纲（仍执行结局/抉择 graph_validate，不跳过场景生成）：
# - 低于 NARRATIVE_FAST_PATH_CHARS（默认 8000）直接节拍骨架
# - 或字数 ≤ OUTLINE_SKIP_MAX_CHARS（默认 20000）且 plot_beats ≥ OUTLINE_SKIP_MIN_BEATS（默认 6）
# NARRATIVE_FAST_PATH_CHARS=8000
# SKIP_OUTLINE_BELOW_CHARS=8000  # legacy alias when NARRATIVE_FAST_PATH_CHARS unset
# OUTLINE_SKIP_MAX_CHARS=20000
# OUTLINE_SKIP_MIN_BEATS=6

# 速度模式：fast=强制跳过 LLM 大纲（不跳过结局/抉择校验）；留空=按字数/节拍自动
# NARRATIVE_SPEED_MODE=fast

# 大纲阶段原文采样字数（圣经已提炼，默认 1000；0=不附原文）
# OUTLINE_SOURCE_SAMPLE_CHARS=1000
# 超过此字数且 plot_beats≥6 时大纲仅用 bible（默认 8000；0=始终附采样）
# OUTLINE_BIBLE_ONLY_CHARS=8000

# 圣经分析采样上限（仅当 LLM_INPUT_CHARS=0 时生效；0=全文；默认 12000）
# BIBLE_INPUT_CHARS=12000

# 场景写作原文节选上限（代码默认 800 / 1600 / 800；可略增以提升贴合度、略减以提速）
# SCENE_EXCERPT_CHARS=800
# SCENE_EXCERPT_MAX_CHARS=1600
# SCENE_EXCERPT_PER_NODE=800

# 长任务进度心跳间隔秒（默认 5-8）
# PROGRESS_TICK_MIN_SEC=5
# PROGRESS_TICK_MAX_SEC=8

# SSE 创建流 keepalive 间隔秒（默认 12）
# SSE_HEARTBEAT_SEC=12

# 同文本+风格重复提交时跳过 analyze 的缓存秒数（0=关闭，默认 1800）
# BIBLE_CACHE_TTL=1800

# 可选：按节点 image_prompt 实时生图（OpenAI 兼容 /images/generations）
# 未配置时使用 frontend 内置场景图库，不影响游玩
# IMAGE_API_BASE=https://api.openai.com/v1
# IMAGE_API_KEY=
#   留空则回退 AI_API_KEY（DeepSeek 等纯文本 API 不支持生图，需单独配置）
# IMAGE_MODEL=dall-e-3

# 生产 CORS（Netlify 前端域名，逗号分隔）
# CORS_ORIGINS=https://2711editor.netlify.app

# 文件上传与 PDF 提取（可选，修改后需重启服务）
# 以下均为 0 = 不限制（默认）
# MAX_UPLOAD_MB=0
# MAX_EXTRACT_CHARS=0
# MAX_CREATE_CHARS=0
# LLM_INPUT_CHARS=0
# LLM_MODEL_SAFE_CHARS=0
# MAX_PDF_PAGES=0
# PDF_PAGE_HARD_CAP=0
